+# ----------------------------------------------------------------------------- split-K GQA decode attention (local patch)
+# Decode (T < 32, no tree): the stock kernel uses one threadgroup per (token, query head), i.e. 24 per token,
+# and scans every key serially, so at long context most of the GPU sits idle (65K: 9.5 tok/s).
+# Here: one threadgroup per (token, KV head, key segment). The 3 query heads sharing a KV head reuse each K/V load.
+# Each segment writes (m, l, acc); a second kernel merges the segments with log-sum-exp and adds the attention sink.
+import os as _os
+
+SPLITK_MIN_CHUNK = int(_os.environ.get("LAMQ_SPLITK_MIN_CHUNK", "256"))
+SPLITK_MAX_SPLIT = int(_os.environ.get("LAMQ_SPLITK_MAX_SPLIT", "128"))
+SPLITK_ON = _os.environ.get("LAMQ_SPLITK", "1") != "0"
+
+
+@lru_cache(maxsize=1)
+def _make_gqa_relpos_split_kernel():
+    src = """
+    const uint s = threadgroup_position_in_grid.x;
+    const uint tk = threadgroup_position_in_grid.y;
+    const uint t = tk / 8u;
+    const uint kvh = tk - t * 8u;
+    const uint simd = simdgroup_index_in_threadgroup; // 0..3
+    const uint lane = thread_index_in_simdgroup;      // 0..31 -> 4 dims each
+
+    const uint kv_len = meta[1], kv_start = meta[2];
+    const uint q_pos = meta[3] + t;
+    const uint kv_cap = meta[4], is_sliding = meta[5], nsplit = meta[6], chunk = meta[7];
+
+    const int min_pos = is_sliding ? ((int)q_pos - 1023) : 0;
+    const uint j_lo0 = (min_pos > (int)kv_start) ? (uint)(min_pos - (int)kv_start) : 0u;
+    const uint j_hi0 = min(kv_len, (q_pos >= kv_start) ? (q_pos - kv_start + 1u) : 0u);
+    const uint j_lo = j_lo0 + s * chunk;
+    const uint j_hi = min(j_hi0, j_lo + chunk);
+
+    float4 qv[3];
+    float4 rs[3][4];
+    for (uint g = 0; g < 3u; g++) {
+        const uint h = kvh * 3u + g;
+        qv[g] = ((const device float4*)(q + ((ulong)t * 24u + h) * 128u))[lane] * (1.0f / 11.313708498984761f);
+        const device float4* rsp = (const device float4*)(rel_st + ((ulong)t * 24u + h) * 16u);
+        rs[g][0] = rsp[0]; rs[g][1] = rsp[1]; rs[g][2] = rsp[2]; rs[g][3] = rsp[3];
+    }
+    const device half4* Kp = (const device half4*)(KV + (ulong)kvh * kv_cap * 128u);
+    const device half4* Vp = (const device half4*)(KV + (ulong)(8u + kvh) * kv_cap * 128u);
+
+    float m[3] = {-1e30f, -1e30f, -1e30f};
+    float l[3] = {0.0f, 0.0f, 0.0f};
+    float4 acc[3] = {float4(0.0f), float4(0.0f), float4(0.0f)};
+
+    for (uint j = j_lo + simd; j < j_hi; j += 4u) {
+        const uint dist = q_pos - (kv_start + j);
+        const float4 k4 = float4(Kp[(ulong)j * 32u + lane]);
+        float3 sc = simd_sum(float3(dot(qv[0], k4), dot(qv[1], k4), dot(qv[2], k4)));
+        if (dist < 1024u) {
+            const device half4* rp = (const device half4*)(rel_proj_t + (ulong)dist * 16u);
+            const float4 r0 = float4(rp[0]), r1 = float4(rp[1]), r2 = float4(rp[2]), r3 = float4(rp[3]);
+            for (uint g = 0; g < 3u; g++)
+                sc[g] += dot(rs[g][0], r0) + dot(rs[g][1], r1) + dot(rs[g][2], r2) + dot(rs[g][3], r3);
+        }
+        const float4 v4 = float4(Vp[(ulong)j * 32u + lane]);
+        for (uint g = 0; g < 3u; g++) {
+            const float m_new = max(m[g], sc[g]);
+            const float alpha = metal::precise::exp(m[g] - m_new);
+            const float p = metal::precise::exp(sc[g] - m_new);
+            l[g] = l[g] * alpha + p;
+            acc[g] = acc[g] * alpha + p * v4;
+            m[g] = m_new;
+        }
+    }
+
+    threadgroup float tg_m[3][4], tg_l[3][4];
+    threadgroup float4 tg_a[3][4][32];
+    for (uint g = 0; g < 3u; g++) {
+        if (lane == 0u) { tg_m[g][simd] = m[g]; tg_l[g][simd] = l[g]; }
+        tg_a[g][simd][lane] = acc[g];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (simd < 3u) {
+        const uint g = simd;
+        float m_all = max(max(tg_m[g][0], tg_m[g][1]), max(tg_m[g][2], tg_m[g][3]));
+        float l_all = 0.0f;
+        float4 a_all = float4(0.0f);
+        for (uint w = 0; w < 4u; w++) {
+            const float sc = metal::precise::exp(tg_m[g][w] - m_all);
+            l_all += tg_l[g][w] * sc;
+            a_all += tg_a[g][w][lane] * sc;
+        }
+        const ulong row = ((ulong)t * 24u + kvh * 3u + g) * nsplit + s;
+        if (lane == 0u) { part_ml[row * 2u] = m_all; part_ml[row * 2u + 1u] = l_all; }
+        ((device float4*)(part_acc + row * 128u))[lane] = a_all;
+    }
+    """
+    return mx.fast.metal_kernel(
+        name="ink_gqa_relpos_sdpa_splitk",
+        input_names=["q", "KV", "rel_st", "rel_proj_t", "meta"],
+        output_names=["part_ml", "part_acc"],
+        source=src,
+    )
+
+
+@lru_cache(maxsize=1)
+def _make_gqa_split_combine_kernel():
+    src = """
+    const uint ht = threadgroup_position_in_grid.y;
+    const uint t = ht / 24u;
+    const uint h = ht - t * 24u;
+    const uint simd = simdgroup_index_in_threadgroup;
+    const uint lane = thread_index_in_simdgroup;
+    const uint tid = simd * 32u + lane;
+    const uint nsplit = meta[0];
+
+    const device float2* qin2 = (const device float2*)(q_in + (ulong)t * 2304u);
+    const device half2* sw2 = (const device half2*)(sink_w + (ulong)h * 2304u);
+    float sk_part = 0.0f;
+    for (uint i = 0; i < 9u; i++) {
+        const uint idx = tid + i * 128u;
+        sk_part += dot(qin2[idx], float2(sw2[idx]));
+    }
+    sk_part = simd_sum(sk_part);
+    threadgroup float tg_sk[4];
+    if (lane == 0u) tg_sk[simd] = sk_part;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (simd == 0u) {
+        const float sk = tg_sk[0] + tg_sk[1] + tg_sk[2] + tg_sk[3];
+        const ulong base = ((ulong)t * 24u + h) * nsplit;
+        float m_all = sk;
+        for (uint s = 0; s < nsplit; s++) m_all = max(m_all, part_ml[(base + s) * 2u]);
+        float l_all = metal::precise::exp(sk - m_all);
+        float4 a_all = float4(0.0f);
+        for (uint s = 0; s < nsplit; s++) {
+            const float sc = metal::precise::exp(part_ml[(base + s) * 2u] - m_all);
+            l_all += part_ml[(base + s) * 2u + 1u] * sc;
+            a_all += ((const device float4*)(part_acc + (base + s) * 128u))[lane] * sc;
+        }
+        ((device float4*)(out + ((ulong)t * 24u + h) * 128u))[lane] = a_all * (1.0f / l_all);
+    }
+    """
+    return mx.fast.metal_kernel(
+        name="ink_gqa_split_combine",
+        input_names=["part_ml", "part_acc", "q_in", "sink_w", "meta"],
+        output_names=["out"],
+        source=src,
+    )
+
+
+def gqa_relpos_sinks_sdpa_splitk(q, KV_buf, rel_st, rel_proj_t_f16, q_in, sink_w_f16, T, kv_len, kv_start, q_pos0, kv_cap, is_sliding):
+    lo = max((q_pos0 - 1023) if is_sliding else 0, kv_start) - kv_start
+    hi = min(kv_len, max(q_pos0 + T - 1 - kv_start + 1, 0))
+    R = max(hi - lo, 1)
+    nsplit = max(1, min(SPLITK_MAX_SPLIT, -(-R // SPLITK_MIN_CHUNK)))
+    chunk = -(-R // nsplit)
+    part_ml, part_acc = _make_gqa_relpos_split_kernel()(
+        inputs=[q.reshape(-1), KV_buf.reshape(-1), rel_st.reshape(-1), rel_proj_t_f16.reshape(-1),
+                _u32(T, kv_len, kv_start, q_pos0, kv_cap, int(is_sliding), nsplit, chunk)],
+        grid=(128 * nsplit, 8 * T, 1),
+        threadgroup=(128, 1, 1),
+        output_shapes=[(T * 24 * nsplit * 2,), (T * 24 * nsplit * 128,)],
+        output_dtypes=[mx.float32, mx.float32],
+    )
+    return _make_gqa_split_combine_kernel()(
+        inputs=[part_ml, part_acc, q_in.reshape(-1), sink_w_f16.reshape(-1), _u32(nsplit)],
+        grid=(128, 24 * T, 1),
+        threadgroup=(128, 1, 1),
+        output_shapes=[(T, 3072)],
+        output_dtypes=[mx.float32],
+    )[0]
+
+
