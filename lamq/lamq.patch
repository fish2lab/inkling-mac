+def ablate(y: mx.array, b: mx.array | None) -> mx.array:
+    """Directional ablation y - b (b^T y); b is a unit float32 vector over the last axis."""
+    if b is None:
+        return y
+    return (y - (y.astype(mx.float32) @ b)[..., None] * b).astype(y.dtype)
+
